        <mxCell id="KeooSsi23h-7iXlSGEQw-34" parent="KeooSsi23h-7iXlSGEQw-1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;p data-key=&quot;S2uHT&quot; data-pm-slice=&quot;1 1 []&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;README&lt;/font&gt;&lt;/p&gt;" vertex="1">
